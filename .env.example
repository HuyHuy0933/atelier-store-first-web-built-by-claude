# Copy to .env.local and fill in values. Never commit real secrets.

# Neon Postgres connection string (Neon console → Connect → pooled connection)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Base URL of the app (used by Better Auth for callbacks and cookies)
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL exposed to the browser (used by the auth client)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
